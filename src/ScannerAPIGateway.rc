IDI_APP_ICON ICON "icon.ico"

#include <windows.h>
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK

#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif

FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ratio Juris"
            VALUE "FileDescription",  "Scanner API Gateway by RatioJuris"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ScannerAPIGateway"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Ratio Juris. All rights reserved."
            VALUE "OriginalFilename", "ScannerAPIGateway.exe"
            VALUE "ProductName",      "Scanner API Gateway"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Scanner API Gateway by RatioJuris."
            VALUE "URL",              "https://github.com/RatioJuris/ScannerAPIGateway/"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
